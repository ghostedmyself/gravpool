{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "antigravity": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Antigravity (CLIProxyAPI)",
      "options": {
        "baseURL": "{env:ANTIGRAVITY_BASE_URL}",
        "apiKey": "{env:ANTIGRAVITY_API_KEY}"
      },
      "models": {
        "claude-sonnet-4-6": { "name": "Claude Sonnet 4.6 (Antigravity)" },
        "claude-opus-4-6-thinking": { "name": "Claude Opus 4.6 Thinking (Antigravity)" },
        "gemini-pro-agent": { "name": "Gemini Pro Agent (Antigravity)" },
        "gemini-3-flash": { "name": "Gemini 3 Flash (Antigravity)" },
        "gemini-3.1-pro-low": { "name": "Gemini 3.1 Pro Low (Antigravity)" },
        "gemini-3.1-flash-lite": { "name": "Gemini 3.1 Flash Lite (Antigravity)" },
        "gemini-3.1-flash-image": { "name": "Gemini 3.1 Flash Image (Antigravity)" },
        "gemini-3.5-flash-lite": { "name": "Gemini 3.5 Flash Lite (Antigravity)" },
        "gemini-3.6-flash-high": { "name": "Gemini 3.6 Flash High (Antigravity)" },
        "gemini-3.7-flash-high": { "name": "Gemini 3.7 Flash High (Antigravity)" },
        "gemini-3.8-flash-high": { "name": "Gemini 3.8 Flash High (Antigravity)" },
        "gpt-oss-120b-medium": { "name": "GPT-OSS 120B (Antigravity)" },
        "gpt-4o": { "name": "GPT-4o (External Provider Example)" }
      }
    }
  }
}